{
  "name": "learncraft-server",
  "version": "1.0.0",
  "description": "LearnCraft — Standalone NestJS Backend API Server",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "sync:catalog": "node scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.25.0",
    "prisma": "^5.22.0",
    "supertest": "^7.1.0",
    "typescript": "^5.8.2",
    "vitest": "^4.0.0"
  }
}
