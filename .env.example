# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Shared Auth Secret (MUST match LearnCraft_client_site AUTH_SECRET for NextAuth JWE verification & internal adapter auth)
AUTH_SECRET=your-auth-secret-here

# Database (PostgreSQL / Neon / Supabase / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/learncraft?schema=public"

# AI Lesson Tutor & Interview Explainer — Free-Tier LLM Providers
# Priority: Gemini -> Groq -> OpenRouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FREE_MODEL_ALLOWLIST=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_DAILY_REQUEST_BUDGET=200
GEMINI_RPM_BUDGET=10

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_MODEL_ALLOWLIST=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b,allam-2-7b
GROQ_DAILY_REQUEST_BUDGET=500
GROQ_RPM_BUDGET=20

OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_FREE_MODEL_ALLOWLIST=cohere/north-mini-code:free,inclusionai/ling-3.2-flash:free
OPENROUTER_DAILY_REQUEST_BUDGET=150
OPENROUTER_RPM_BUDGET=10

# AI Guardrails
TUTOR_USER_DAILY_LIMIT=5
TUTOR_MAX_OUTPUT_TOKENS=600
TUTOR_REQUEST_TIMEOUT_MS=15000
TUTOR_PROMPT_VERSION=v1
INTERVIEW_EXPLAINER_PROMPT_VERSION=interview-v1
TUTOR_DAILY_TIME_ZONE=UTC
