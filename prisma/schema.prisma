datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress           Progress[]
  tutorConversations TutorConversation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Progress {
  id               String   @id @default(cuid())
  userId           String
  module           String
  completed        Boolean  @default(false)
  score            Int?
  activeModule     String?
  completedModules String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model InterviewQuestionRecord {
  id              String   @id @default(cuid())
  questionId      String   @unique
  trackKey        String
  topic           String?
  subtopic        String?
  category        String   @default("conceptual")
  type            String   @default("conceptual")
  difficulty      String
  question        String
  answer          String
  explanation     String?
  example         String?
  codeSnippet     String?
  expectedOutput  String?
  followUps       String[] @default([])
  keyPoints       String[] @default([])
  tags            String[] @default([])
  source          String   @default("curated")
  status          String   @default("APPROVED")
  rejectionReason String?
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([trackKey, status])
  @@index([difficulty])
  @@map("interview_questions")
}

model TutorAnswerCache {
  id            String   @id @default(cuid())
  cacheKey      String   @unique
  lessonId      String
  action        String
  contentHash   String
  promptVersion String
  codeHash      String?
  answer        String
  provider      String
  model         String
  createdAt     DateTime @default(now())

  @@index([lessonId, contentHash])
  @@index([promptVersion])
  @@map("tutor_answer_cache")
}

model TutorDailyUsage {
  id           String   @id @default(cuid())
  userId       String
  usageDate    String
  requestCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, usageDate])
  @@index([userId])
  @@map("tutor_daily_usage")
}

model TutorProviderUsage {
  id            String    @id @default(cuid())
  provider      String
  usageDate     String
  requestCount  Int       @default(0)
  dailyBudget   Int
  windowStart   DateTime?
  windowCount   Int       @default(0)
  cooldownUntil DateTime?
  lastErrorCode String?
  updatedAt     DateTime  @updatedAt

  @@unique([provider, usageDate])
  @@index([provider])
  @@map("tutor_provider_usage")
}

enum TutorMessageRole {
  USER
  ASSISTANT
}

model TutorConversation {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  lessonTitle String?
  title       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([userId, lessonId, updatedAt])
  @@map("tutor_conversations")
}

model TutorMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           TutorMessageRole
  content        String           @db.Text
  createdAt      DateTime         @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("tutor_messages")
}
